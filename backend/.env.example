PROJECT_NAME="Nautical ERP Automation"
VERSION="1.0.0-mvp"

# Database connection:
# SQLite async default for zero-setup local demo:
DATABASE_URL="sqlite+aiosqlite:///./nautical_erp.db"

# Or PostgreSQL connection:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nautical_db"

# Google Gemini API Key (optional for heuristic fallback, required for live LLM superintendent synthesis):
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Safety margin for bunker calculation (15% reserve standard):
BUNKER_SAFETY_BUFFER_PERCENT=15.0
